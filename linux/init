#!/bin/sh
# The S5 initramfs's init: mount the usual filesystems, say where we are, and give the console a shell.
/bin/busybox --install -s           # every applet: top, vi, ps, less, ip, ...
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
exec 0</dev/console 1>/dev/console 2>&1 # the kernel found no /dev/console before devtmpfs
echo
echo "S5: Linux $(uname -r) on the YPCB-00338-1P1 card, $(grep -c ^processor /proc/cpuinfo) hart(s)"
grep -E 'isa|mmu' /proc/cpuinfo | sort -u
free -m
hostname -F /etc/hostname
echo "Run 'memtest [MiB] [passes]' to test main memory (DDR3 channel A), 'membench' to time it."
cd /root
exec setsid cttyhack /bin/bash -l
