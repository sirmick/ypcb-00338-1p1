#!/bin/bash
# card: the guest SoC on the YPCB-00338-1P1 (SOC-ROADMAP S5). From buzz it builds there and runs on dino;
# on dino itself it uses what buzz last put in ~/fpga/card/.
#
#   card up [--load] [bitstream]
#                         make sure the card runs designs/soc-s5 (load it if the card is not enumerated as
#                         10ee:0485, or always with --load; Linux re-enumerates it live), bind it to vfio-pci,
#                         then boot the guest: cardd loads OpenSBI and Linux and serves the console on a socket
#   card console          attach this terminal to the guest's console (raw). Ctrl-] is the escape key:
#                         then r resets the guest (you stay attached and watch it boot), q detaches
#   card reset            reboot the guest: hold the cores, reload both images, release (the console stays)
#   card stop             stop cardd (the guest keeps running, without a console, until the next reset)
#   card log              cardd's own log (loads, errors)
#   card status           PCIe device, driver, cardd, and the card's JTAG debug register
#   card build            rebuild cardd, OpenSBI, the initramfs and the kernel (also done by `up` when missing)
#
# Images build into $CARD_BUILD (default ~/fpga/build/s5); they and cardd go to dino:~/fpga/card/.
set -eo pipefail
HW=$(cd "$(dirname "$0")" && pwd)
HOST=${FPGA_HOST:-dino}
OUT=${CARD_BUILD:-$HOME/fpga/build/s5}
BDF=${CARD_BDF:-0000:04:00.0}
ID=10ee:0485
REMOTE=fpga/card
SOCK=/run/cardd/console.sock

LOCAL=; [[ $(hostname -s) == "$HOST" ]] && LOCAL=1   # running on the card host itself
on_dino() { if [[ -n $LOCAL ]]; then (cd && bash -c "$*"); else ssh "$HOST" "$@"; fi; }

build() {
    (cd "$HW/cardd" && cargo build --release -q)
    "$HW/linux/build-opensbi.sh" "$OUT" | tail -1
    "$HW/linux/build-initramfs.sh" "$OUT"
    "$HW/linux/build-kernel.sh" "$OUT" "$OUT/initramfs" | tail -1
}

push() {
    if [[ -n $LOCAL ]]; then
        for f in cardd fw_jump.bin Image; do
            [[ -s $HOME/$REMOTE/$f ]] || { echo "card: no $REMOTE/$f here: run 'hw/card build' and 'hw/card up' on buzz first" >&2; exit 1; }
        done
        return
    fi
    [[ -s $OUT/fw_jump.bin && -s $OUT/Image && -x $HW/cardd/target/release/cardd ]] || build
    on_dino mkdir -p "$REMOTE"
    rsync -a "$HW/cardd/target/release/cardd" "$OUT/fw_jump.bin" "$OUT/Image" "$HOST:$REMOTE/"
}

ensure_card() {
    local force=; [[ ${1:-} == --load ]] && { force=1; shift; }
    if [[ -n $force ]] || ! on_dino lspci -n -s "${BDF#0000:}" | grep -q "$ID"; then
        stop
        local bit=${1:-designs/soc-s5/build/soc_s5.bit}
        # Reconfiguring the FPGA drops its PCIe endpoint; Linux re-enumerates it live. (A rescanned device
        # starts with Memory Space Enable off, so BAR0 reads all-ones until a driver enables it: cardd does,
        # through VFIO. No reboot is needed.)
        echo "card: loading $bit (the card leaves the bus and comes back)"
        on_dino "[ -e /sys/bus/pci/devices/$BDF ] && echo 1 | sudo -n tee /sys/bus/pci/devices/$BDF/remove >/dev/null" || true
        "$HW/fpga" load "$bit" | tail -1
        on_dino "sleep 2; echo 1 | sudo -n tee /sys/bus/pci/rescan >/dev/null; sleep 1"
        on_dino lspci -n -s "${BDF#0000:}" | grep -q "$ID" || { echo "card: $ID did not come back after a rescan" >&2; exit 1; }
    fi
    on_dino "sudo -n modprobe vfio-pci
             d=/sys/bus/pci/devices/$BDF
             if [ \"\$(basename \$(readlink \$d/driver 2>/dev/null) 2>/dev/null)\" != vfio-pci ]; then
                 [ -e \$d/driver ] && echo $BDF | sudo -n tee \$d/driver/unbind >/dev/null
                 echo vfio-pci | sudo -n tee \$d/driver_override >/dev/null
                 echo $BDF | sudo -n tee /sys/bus/pci/drivers_probe >/dev/null
             fi"
}

stop() { on_dino "sudo -n pkill -x cardd; for i in 1 2 3 4 5; do pgrep -x cardd >/dev/null || break; sleep 0.5; done" || true; }

start() {
    stop
    # detached from this ssh session entirely, or ssh waits for it
    on_dino "cd $REMOTE && setsid -f sh -c 'sudo -n ./cardd boot $BDF fw_jump.bin Image --socket $SOCK > cardd.log 2>&1' < /dev/null > /dev/null 2>&1"
    for _ in $(seq 1 40); do
        if on_dino grep -q "released the cores" "$REMOTE/cardd.log" 2>/dev/null; then
            on_dino cat "$REMOTE/cardd.log"; echo "card: booting; attach with: card console"; return
        fi
        on_dino "pgrep -f '[c]ardd boot' >/dev/null" || { on_dino cat "$REMOTE/cardd.log"; echo "card: cardd failed" >&2; exit 1; }
        sleep 0.5
    done
    echo "card: cardd did not release the cores in 20 s" >&2; on_dino cat "$REMOTE/cardd.log"; exit 1
}

cmd=${1:-help}; shift || true
case $cmd in
  up)      push; ensure_card "$@"; start ;;
  reset)   push
           if on_dino "pgrep -f '[c]ardd boot' >/dev/null"; then on_dino "sudo -n $REMOTE/cardd reset $SOCK"; else start; fi ;;
  console) if [[ -n $LOCAL ]]; then exec sudo -n "$HOME/$REMOTE/cardd" console $SOCK; fi
           exec ssh -t "$HOST" "sudo -n $REMOTE/cardd console $SOCK" ;;
  stop)    stop; echo "card: cardd stopped" ;;
  log)     on_dino cat "$REMOTE/cardd.log" ;;
  status)  on_dino "lspci -nn -s ${BDF#0000:}; echo driver: \$(basename \$(readlink /sys/bus/pci/devices/$BDF/driver 2>/dev/null) 2>/dev/null)
                    pgrep -ax cardd || echo 'cardd: not running'"
           "$HW/fpga" check designs/soc-s5 || true ;;
  build)   [[ -z $LOCAL ]] || { echo "card: build on buzz (sources and toolchains live there)" >&2; exit 1; }
           build ;;
  *)       sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
